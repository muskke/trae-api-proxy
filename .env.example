# trae-api-proxy v0.4.x
# Copy to .env. Keep .env and data/trae-auth.json private; both are ignored by Git.

# HTTP server
BIND=127.0.0.1
PORT=8000

# Optional client authentication for this proxy.
# Strongly recommended if anything other than localhost can reach the service.
AUTH_TOKEN=

# TRAE authentication lifecycle:
#   auto        = managed OAuth credential > static TRAE_IDE_TOKEN > request passthrough
#   oauth       = managed browser login only
#   token       = static TRAE_IDE_TOKEN only
#   passthrough = client Bearer/X-API-Key is used upstream
TRAE_AUTH_MODE=auto
TRAE_AUTH_FILE=./data/trae-auth.json

# Backward-compatible static-token mode/fallback. Leave empty when using browser login.
TRAE_IDE_TOKEN=
TRAE_UID=
TRAE_DEVICE_ID=
TRAE_MACHINE_ID=
TRAE_DEVICE_CPU=

# Managed browser login / automatic refresh.
# Normal users should not need to change these defaults.
TRAE_OAUTH_HOST=https://api.trae.com.cn
TRAE_OAUTH_CONSOLE_URL=https://www.trae.cn/authorization
TRAE_OAUTH_CLIENT_ID=en1oxy7wnw8j9n
TRAE_OAUTH_EXCHANGE_PATH=/cloudide/api/v3/trae/oauth/ExchangeToken
TRAE_OAUTH_USERINFO_PATH=/cloudide/api/v3/trae/GetUserInfo
TRAE_OAUTH_PLUGIN_VERSION=2.3.62834
TRAE_OAUTH_CALLBACK_PORT=18080
# Leave empty to derive http://127.0.0.1:${TRAE_OAUTH_CALLBACK_PORT}.
TRAE_OAUTH_CALLBACK_BASE_URL=
# Bare-metal default is the callback URL host. Compose overrides this to 0.0.0.0 inside the container.
TRAE_OAUTH_CALLBACK_BIND=
TRAE_OAUTH_REFRESH_SKEW=24h
TRAE_OAUTH_REFRESH_INTERVAL=15m
TRAE_OAUTH_LOGIN_TTL=10m

# Upstream protocol: auto | solo | legacy
# auto prefers the current SOLO endpoint and falls back to legacy only for 404/405.
TRAE_UPSTREAM_MODE=auto
TRAE_API_BASE_URL=https://trae-api-cn.mchost.guru
TRAE_DEFAULT_MODEL=glm-5.2
TRAE_LOCALE=zh-cn

# Optional client model aliases. Separate entries with comma or semicolon.
# Example: TRAE_MODEL_ALIASES=fast=glm-5.2;coding=DeepSeek-V4-Flash-Official
TRAE_MODEL_ALIASES=

# Current SOLO client fingerprint defaults. Override only when needed.
TRAE_APP_ID=6eefa01c-1036-4c7e-9ca5-d891f63bfcd8
TRAE_APP_VERSION=default
TRAE_IDE_VERSION=0.1.52
TRAE_IDE_VERSION_CODE=20260811
TRAE_IDE_VERSION_TYPE=stable
TRAE_DEVICE_BRAND=83DG
TRAE_DEVICE_TYPE=windows
TRAE_OS_VERSION=Windows 11 Pro
TRAE_REQUEST_TRAFFIC_TYPE=prod

# Reliability / limits
TRAE_REQUEST_TIMEOUT=120s
TRAE_RESPONSE_HEADER_TIMEOUT=120s
TRAE_MODEL_CACHE_TTL=1h
SHUTDOWN_TIMEOUT=10s
MAX_BODY_BYTES=8388608

# Optional browser API access. Leave empty to disable CORS headers.
# Example: CORS_ALLOW_ORIGIN=http://127.0.0.1:3000
CORS_ALLOW_ORIGIN=
