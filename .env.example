# trae-api-proxy v0.5.0
# Copy to .env. Keep .env and data/ private; both are ignored by Git.

# HTTP server
BIND=127.0.0.1
PORT=8000

# Optional client authentication for this proxy.
# Strongly recommended if anything other than localhost can reach the service.
AUTH_TOKEN=

# TRAE authentication lifecycle:
#   auto        = managed OAuth credential > static TRAE_IDE_TOKEN > request passthrough
#   oauth       = managed browser login only
#   token       = static TRAE_IDE_TOKEN only
#   passthrough = client Bearer/X-API-Key is used upstream
TRAE_AUTH_MODE=auto
TRAE_AUTH_FILE=./data/trae-auth.json

# Browser-login platform:
#   global      = TRAE Global / trae.ai (recommended default)
#   global-solo = TRAE SOLO Global
#   cn          = TRAE China / trae.cn
#   cn-solo     = TRAE SOLO China
TRAE_OAUTH_PLATFORM=global

# Backward-compatible static-token mode/fallback. Leave empty when using browser login.
TRAE_IDE_TOKEN=
TRAE_UID=
TRAE_DEVICE_ID=
TRAE_MACHINE_ID=
TRAE_DEVICE_CPU=

# Managed browser login / automatic refresh.
# Normal Global TRAE users should leave these empty/default so platform routing,
# LoginGuidance and local IDE product metadata can be detected automatically.
TRAE_OAUTH_HOST=https://api.trae.ai
TRAE_OAUTH_CONSOLE_URL=https://www.trae.ai/authorization
TRAE_OAUTH_CLIENT_ID=
# Optional comma/semicolon-separated override. Empty uses platform defaults.
TRAE_OAUTH_GUIDANCE_URLS=
TRAE_OAUTH_EXCHANGE_PATH=/cloudide/api/v3/trae/oauth/ExchangeToken
TRAE_OAUTH_AUTH_CODE_EXCHANGE_PATH=/trae/api/v3/oauth/ExchangeToken
TRAE_OAUTH_USERINFO_PATH=/cloudide/api/v3/trae/GetUserInfo
# Leave empty to prefer the installed TRAE product.json value, then the built-in fallback.
TRAE_OAUTH_PLUGIN_VERSION=
TRAE_OAUTH_CALLBACK_PORT=18080
# Leave empty to derive http://127.0.0.1:${TRAE_OAUTH_CALLBACK_PORT}.
TRAE_OAUTH_CALLBACK_BASE_URL=
# Bare-metal default is the callback URL host. Compose overrides this to 0.0.0.0 inside the container.
TRAE_OAUTH_CALLBACK_BIND=
TRAE_OAUTH_REFRESH_SKEW=24h
TRAE_OAUTH_REFRESH_INTERVAL=15m
TRAE_OAUTH_LOGIN_TTL=10m

# Optional path to an installed TRAE app directory or product.json.
# When available, v0.5.0 auto-detects appVersion/tronBuildVersion/auth client id.
TRAE_APP_PATH=

# Upstream protocol: auto | solo | legacy
# "solo" here means the current v3 llm_utils_chat wire protocol, not the SOLO product.
# Standard TRAE uses chat_v3 on this endpoint; TRAE SOLO uses solo_work_lite.
# auto prefers the current endpoint and falls back to legacy only for 404/405.
TRAE_UPSTREAM_MODE=auto
# Global default. A managed OAuth session can switch to US/CN according to login region.
TRAE_API_BASE_URL=https://coresg-normal.trae.ai
TRAE_DEFAULT_MODEL=glm-5.2
TRAE_LOCALE=en

# Optional client model aliases. Separate entries with comma or semicolon.
# Example: TRAE_MODEL_ALIASES=fast=glm-5.2;coding=DeepSeek-V4-Flash-Official
TRAE_MODEL_ALIASES=

# Client fingerprint. Installed product metadata is preferred for the auth fields below;
# explicit environment variables always win.
TRAE_APP_ID=6eefa01c-1036-4c7e-9ca5-d891f63bfcd8
TRAE_APP_VERSION=default
TRAE_IDE_VERSION=
TRAE_IDE_VERSION_CODE=20260811
TRAE_IDE_VERSION_TYPE=stable
TRAE_DEVICE_BRAND=
TRAE_DEVICE_TYPE=
TRAE_OS_VERSION=
TRAE_REQUEST_TRAFFIC_TYPE=prod

# Reliability / limits
TRAE_REQUEST_TIMEOUT=120s
TRAE_RESPONSE_HEADER_TIMEOUT=120s
TRAE_MODEL_CACHE_TTL=1h
# Learned per-account model availability. A minimal chat that succeeds becomes usable;
# a minimal chat rejected with TRAE code 4001 becomes temporarily unavailable.
TRAE_MODEL_FAILURE_TTL=30m
TRAE_MODEL_SUCCESS_TTL=6h
# Persist learned model status across restarts. Stored atomically under data/ by default.
TRAE_MODEL_STATUS_FILE=./data/model-status.json

# OpenAI reasoning compatibility:
#   preserve = emit reasoning_content separately (default)
#   merge    = append reasoning tokens to normal content for older clients
#   drop     = suppress reasoning_content and emit answer content only
TRAE_REASONING_MODE=preserve
SHUTDOWN_TIMEOUT=10s
MAX_BODY_BYTES=8388608

# Optional browser API access. Leave empty to disable CORS headers.
# Example: CORS_ALLOW_ORIGIN=http://127.0.0.1:3000
CORS_ALLOW_ORIGIN=
