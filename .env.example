# trae-api-proxy v0.3.x
# Copy to .env, then fill in your own token/device values.

# HTTP server
BIND=0.0.0.0
PORT=8000

# Optional local client authentication.
# Recommended for anything beyond localhost. When set, TRAE_IDE_TOKEN is required.
AUTH_TOKEN=

# TRAE account/session
TRAE_IDE_TOKEN=
TRAE_UID=
TRAE_DEVICE_ID=
TRAE_MACHINE_ID=
TRAE_DEVICE_CPU=

# Upstream protocol: auto | solo | legacy
# auto prefers the current SOLO endpoint and falls back to legacy only for 404/405.
TRAE_UPSTREAM_MODE=auto
TRAE_API_BASE_URL=https://trae-api-cn.mchost.guru
TRAE_DEFAULT_MODEL=glm-5.2
TRAE_LOCALE=zh-cn

# Optional client model aliases. Separate entries with comma or semicolon.
# Example: TRAE_MODEL_ALIASES=fast=glm-5.2;coding=DeepSeek-V4-Flash-Official
TRAE_MODEL_ALIASES=

# Current SOLO client fingerprint defaults. Override only when needed.
TRAE_APP_ID=6eefa01c-1036-4c7e-9ca5-d891f63bfcd8
TRAE_APP_VERSION=default
TRAE_IDE_VERSION=0.1.52
TRAE_IDE_VERSION_CODE=20260811
TRAE_IDE_VERSION_TYPE=stable
TRAE_DEVICE_BRAND=83DG
TRAE_DEVICE_TYPE=windows
TRAE_OS_VERSION=Windows 11 Pro
TRAE_REQUEST_TRAFFIC_TYPE=prod

# Reliability / limits
TRAE_REQUEST_TIMEOUT=120s
TRAE_RESPONSE_HEADER_TIMEOUT=120s
TRAE_MODEL_CACHE_TTL=1h
SHUTDOWN_TIMEOUT=10s
MAX_BODY_BYTES=8388608

# Optional browser access. Leave empty to disable CORS headers.
# Example: CORS_ALLOW_ORIGIN=http://127.0.0.1:3000
CORS_ALLOW_ORIGIN=
